# ==============================================================================
# AGNI-RAKSHAK PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Backend API Endpoint (used by python-ai edge worker)
BACKEND_URL=http://localhost:5080

# Video Source:
# - USB/Local Webcam index: 0, 1, 2
# - IP Camera RTSP Stream: rtsp://username:password@192.168.1.100:554/stream
# - Test Video File Path: /path/to/wildfire_footage.mp4
VIDEO_SOURCE=0

# AI Detection Parameters
SEND_INTERVAL_SEC=0.4
JPEG_QUALITY=80
YOLO_MODEL_PATH=yolov8n-fire.pt

# Telegram Bot Critical Disaster Alert Integration
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_COOLDOWN_SEC=60
